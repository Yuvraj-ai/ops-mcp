# Get this from your Supabase project's Connection Pooling settings.
# Use the pooler endpoint (IPv4) — it works from all hosting environments.
DATABASE_URL=postgresql://postgres.eovrhybvjtkkevxmuifb:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Optional. Tests run against a REAL Postgres instance (never an in-memory mock —
# see docs/handoff.md §5.5.1). If unset, tests fall back to DATABASE_URL.
#
# Safe either way: the test harness pins its connections to a dedicated schema
# (TEST_SCHEMA, default `ops_mcp_test`) which it drops and recreates on every run,
# so demo/business data in the `public` schema is never touched by a test run.
# TEST_DATABASE_URL=postgresql://...
# TEST_SCHEMA=ops_mcp_test
